# This is a .gitignore file for a Django project.
# It ignores common files and directories that should not be tracked by Git.

# Python cache files
__pycache__/
*.pyc
*.pyo

# Python test files
*.pytest_cache/
.pytest_history

# Django-specific files
.DS_Store # macOS
.idea/ # IntelliJ IDEA
*.sqlite3 # SQLite database files
local_settings.py # Local settings file
db.sqlite3 # Default SQLite database file
media/ # Media files (images, documents, etc.)
static/ # Root static directory (collected files)
*.log # Log files

# Python cache files
*/__pycache__/

# Virtual environment files
venv/
env/
.venv/

# IDE-specific files
.vscode/
*.suo # Visual Studio
*.user # Visual Studio
mcp.json # Visual Studio Code

# Build files
dist/
build/

# Miscellaneous
*.swp # Vim swap files
*~ # Emacs temporary files

# secrets
local_settings.py

# Django media files and the collected static files (only at the root: the apps' static/ folders are source)
/media/
/static/

# SQLite database file, its WAL files and backups
db.sqlite3
db.sqlite3-wal
db.sqlite3-shm
db.sqlite3.bak*

nohup.out

# Map tiles downloaded for the daily report maps
tile_cache/
